# Segnaposto: nessun segreto reale. Copia in .env (non versionato) e compila.
NODE_ENV=development
PORT=8787
HOST=127.0.0.1
DB_PATH=./data/app.sqlite
# Segreto per l'HMAC dei codici OTP (>=16 caratteri, es. `openssl rand -hex 32`). Obbligatorio in produzione.
AUTH_SECRET=
# Origini CORS consentite, separate da virgola (vuoto = nessun header CORS).
CORS_ORIGINS=http://localhost:5173
# Dimensione massima del body in byte.
MAX_BODY_BYTES=2000000
# Reverse proxy e IP del client (serve ai rate-limit per IP). Valori:
#   auto (default, anche se vuoto) = X-Forwarded-For fidato SOLO se la connessione arriva da un indirizzo loopback/privato (Caddy sulla stessa macchina o rete docker)
#   0 = mai fidato (server esposto direttamente) · 1 = un proxy davanti (Caddy) · 2 = due (es. CDN + Caddy), ecc.: si usa il valore N-esimo da DESTRA di X-Forwarded-For.
# Un valore sbagliato fa vedere tutti i client con lo stesso IP, oppure permette di falsificarlo.
TRUST_PROXY=auto
# Solo sviluppo: 1 = /v1/auth/request restituisce {devCode} (ignorato in produzione).
AUTH_DEV_RETURN_CODE=0
# SMTP (obbligatorio in produzione). Esempio: smtp://utente:password@smtp.example.com:587  (smtps:// per TLS implicito)
SMTP_URL=
SMTP_FROM=no-reply@example.com
SMTP_REQUIRE_TLS=0
# Rate-limit OTP (opzionali, valori di default indicati). Per COPPIA email+IP c'e' inoltre un backoff esponenziale sugli errori (3 errori -> 1 min, 2 min, 4 min... max 1 h).
# RL_OTP_REQUEST_IP_HOUR=20        # richieste di codice per IP
# RL_OTP_REQUEST_PAIR_HOUR=5       # richieste per coppia email+IP (limite "personale" dell'attaccante)
# RL_OTP_REQUEST_EMAIL_HOUR=10     # tetto globale per email (piu' alto della coppia: un attaccante singolo non puo' esaurirlo)
# RL_OTP_VERIFY_IP_10MIN=30
# RL_OTP_VERIFY_EMAIL_10MIN=15     # tentativi di verifica per email (tutti gli IP)
# Rate-limit generale delle API (per IP prima del login, per tenant dopo). RATE_LIMIT_STORE: memory (default, per processo) | db (persistito, condiviso)
# RATE_LIMIT_STORE=memory
# RL_IP_PER_MIN=600
# RL_TENANT_PER_MIN=300
# RL_TENANT_WRITES_PER_MIN=120
# RL_SYNC_OPS_HOUR=20000
# RL_EXPORT_PER_DAY=5
# Limiti di sync
# CLOCK_SKEW_MAX_MS=600000         # tolleranza sull'ora dei dispositivi (updatedAt oltre now+tolleranza viene riportato al limite)
# MAX_DOC_BYTES=1500000
# MAX_CATALOG_ITEMS=5000
# SYNC_PULL_MAX_BYTES=4000000
# Termini di servizio e DPA (art. 28 GDPR) al primo accesso (campo opzionale acceptedTerms di /v1/auth/verify)
# REQUIRE_TERMS=0                  # 1 = obbligatori per creare un account (400 terms_required altrimenti, senza bruciare il codice)
# TERMS_CURRENT_VERSION=           # se impostata, la versione accettata deve coincidere
# DPA_CURRENT_VERSION=
# TERMS_STORE_IP_HASH=0            # 1 = salva anche HMAC(AUTH_SECRET, IP) come prova (minimizzazione: di default NO)
# Cifratura applicativa AES-256-GCM dei campi sensibili (anagrafica cliente, note, trascrizioni, XML, profilo/IBAN, log di sync).
# Genera con `openssl rand -base64 32`. NON perderla (senza chiave i dati cifrati sono illeggibili) e conservala FUORI dal repository e dai backup del DB.
# APP_ENCRYPTION_KEY=
# APP_ENCRYPTION_KEY_ID=k1
# APP_ENCRYPTION_OLD_KEYS=         # rotazione: "k1:<vecchia chiave>,k0:<...>" (solo decifratura). Vedi scripts/rotate-encryption-key.ts
# Billing: tolleranza oltre currentPeriodEnd prima di declassare un abbonamento 'active' (webhook di rinnovo in ritardo)
# BILLING_PERIOD_SLACK_DAYS=3
# BILLING_GRACE_DAYS=7
# ---- Operazioni (SERVER-OPS, vedi docs/OPERAZIONI.md) ----
# Metriche Prometheus su GET /metrics: token Bearer di almeno 16 caratteri (`openssl rand -hex 24`). Se assente (o troppo corto) /metrics e' DISABILITATO (404).
# Lo stesso token abilita i dettagli (numeri) di GET /health/deep; senza token /health/deep mostra solo gli stati ok/warn/fail.
# METRICS_TOKEN=
# Lancio privato: 1 = per CREARE un account serve un codice invito monouso (`admin.ts create-invite-code`). Chi ha gia' un account entra come prima.
# INVITE_ONLY=0
# RL_INVITE_FAIL_HOUR=10           # codici invito errati per IP all'ora
# Cartella dei backup (/health/deep ne controlla l'eta'; `admin.ts backup` ci scrive). Default: <cartella del DB>/backups se esiste.
# BACKUP_DIR=/var/lib/vocepreventivo/backups
# BACKUP_MAX_AGE_HOURS=36          # oltre questa eta' /health/deep segnala "degraded"
# DISK_WARN_FREE_MB=1024           # spazio libero sotto il quale /health/deep segnala "degraded"
# DISK_CRIT_FREE_MB=200            # ... e sotto il quale risponde 503 "fail"
# Manutenzione automatica (ogni ora): pulizie + wal_checkpoint(PASSIVE) + PRAGMA optimize giornaliero.
# MAINTENANCE_CHECKPOINT=1         # 0 = niente checkpoint applicativo
# TOMBSTONE_RETENTION_DAYS=180     # bozze/preventivi/voci di catalogo eliminati: dopo quanti giorni si cancellano del tutto
# VACUUM (riscrive tutto il DB; con Litestream la replica lo ricopia): spento di default. Se acceso: nella finestra oraria, al massimo ogni N giorni, solo se serve.
# MAINTENANCE_VACUUM=0
# MAINTENANCE_HOUR_UTC=3
# MAINTENANCE_VACUUM_MIN_DAYS=7
# MAINTENANCE_VACUUM_MIN_FREE_MB=8   # e almeno il 20% del file libero
# MAINTENANCE_VACUUM_MAX_MB=500      # DB piu' grandi: niente VACUUM automatico
# Arresto ordinato (SIGTERM/SIGINT): tempo massimo per finire le richieste in corso, poi chiusura forzata.
# SHUTDOWN_TIMEOUT_MS=10000        # con systemd tenere TimeoutStopSec >= 15
# silent = niente log di richiesta
LOG_LEVEL=info
