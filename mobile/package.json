{
  "name": "vocepreventivo-mobile",
  "private": true,
  "version": "0.1.0",
  "description": "Wrapper Capacitor (Android/iOS) della PWA: la web app si costruisce nella root con `npm run build` (cartella dist).",
  "scripts": {
    "build:web": "npm --prefix .. run build",
    "assets": "node scripts/make-assets.mjs && capacitor-assets generate --android --ios --assetPath assets",
    "sync": "cap sync",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "patch:native": "node scripts/patch-native.mjs",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-speech-recognition": "^8.4.6"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  }
}
