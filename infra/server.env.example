# Installazione SENZA Docker. Sul server questo file diventa /etc/vocepreventivo/server.env
# (proprietario vocepreventivo, permessi 600), creato da setup-vps.sh.
# I valori qui sotto sono SOLO segnaposto: sostituisci ogni CHANGE_ME.
# Se un valore contiene spazi o simboli (& $ #) mettilo tra apici singoli.

# --- Server applicativo (HOST e PORT sono gia' impostati nell'unit systemd) ---
DB_PATH=/var/lib/vocepreventivo/vocepreventivo.sqlite
# Chiave master per cifrare i campi sensibili: `openssl rand -base64 32`
APP_ENCRYPTION_KEY=CHANGE_ME
# Segreto per firmare i token di sessione: `openssl rand -base64 48`
AUTH_SECRET=CHANGE_ME

# --- Email transazionali (se usate) ---
SMTP_URL=CHANGE_ME
MAIL_FROM=CHANGE_ME@example.invalid

# --- Stripe (se attivo) ---
STRIPE_SECRET_KEY=CHANGE_ME
STRIPE_WEBHOOK_SECRET=CHANGE_ME

# --- Provider SDI ---
SDI_PROVIDER=mock
SDI_API_KEY=CHANGE_ME
SDI_WEBHOOK_SECRET=CHANGE_ME

# --- Voce / LLM di fallback (opzionali) ---
STT_API_KEY=CHANGE_ME
LLM_API_KEY=CHANGE_ME

# --- Litestream: replica su bucket S3-compatibile ---
#   Backblaze B2:  https://s3.<regione>.backblazeb2.com
#   Hetzner:       https://<localita>.your-objectstorage.com
#   Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com  (region: auto)
LITESTREAM_ENDPOINT=https://CHANGE_ME
LITESTREAM_REGION=CHANGE_ME
LITESTREAM_BUCKET=CHANGE_ME
LITESTREAM_PATH=vocepreventivo/prod
LITESTREAM_ACCESS_KEY_ID=CHANGE_ME
LITESTREAM_SECRET_ACCESS_KEY=CHANGE_ME

# --- Backup locali ---
BACKUP_KEEP_DAYS=14
# Chiave PUBBLICA age ("age1...") per cifrare gli snapshot; vuoto = non cifra.
AGE_RECIPIENT=

# --- Aggiunte sicurezza (vedi server/.env.example e docs/SECURITY-REVIEW.md) ---
REQUIRE_TERMS=1
TERMS_STORE_IP_HASH=0
RATE_LIMIT_STORE=db
TRUST_PROXY=auto
NODE_ENV=production

# --- CORS: origini ammesse a chiamare l'API da altri contesti (separate da virgola, nessuno spazio, MAI "*") ---
# capacitor://localhost = app iOS; https://localhost = app Android; https://[DOMINIO] = la PWA stessa (sostituisci [DOMINIO]).
# La PWA sullo stesso dominio non ne ha bisogno, ma non fa male. L'app nativa richiede anche VITE_API_URL assoluto in fase di build.
CORS_ORIGINS=capacitor://localhost,https://localhost,https://[DOMINIO]

# --- Accesso e audit (vedi server/.env.example) ---
OTP_DIGITS=8
AUDIT_RETENTION_DAYS=365
HEALTH_CACHE_MS=5000

# --- Stripe: prezzi e ritorno dal pagamento (devono coincidere con src/billing/pricing.ts) ---
STRIPE_PRICE_MONTH=CHANGE_ME
STRIPE_PRICE_YEAR=CHANGE_ME
STRIPE_SUCCESS_URL=https://[DOMINIO]/#/account?checkout=success
STRIPE_CANCEL_URL=https://[DOMINIO]/#/account?checkout=cancel
