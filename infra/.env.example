# Copia questo file in infra/.env SUL SERVER (cp .env.example .env && chmod 600 .env)
# e sostituisci ogni CHANGE_ME. Il file .env NON va mai messo in git.
# I valori qui sotto sono SOLO segnaposto. Se un valore contiene spazi o simboli (& $ #), mettilo tra apici singoli.

# --- Dominio e HTTPS ---
DOMAIN=app.CHANGE_ME.example
ACME_EMAIL=CHANGE_ME@example.invalid

# --- Immagini Docker (il deploy imposta APP_TAG da solo) ---
APP_TAG=latest

# --- Server applicativo ---
NODE_ENV=production
PORT=8787
# Percorso del DB SQLite DENTRO il container (volume /data)
DB_PATH=/data/vocepreventivo.sqlite
# Chiave master per cifrare i campi sensibili (AES-256-GCM): genera con `openssl rand -base64 32`
APP_ENCRYPTION_KEY=CHANGE_ME
# Segreto per firmare i token di sessione: genera con `openssl rand -base64 48`
AUTH_SECRET=CHANGE_ME

# --- Email transazionali (OTP/notifiche), se usate ---
SMTP_URL=CHANGE_ME
MAIL_FROM=CHANGE_ME@example.invalid

# --- Stripe (se attivo) ---
STRIPE_SECRET_KEY=CHANGE_ME
STRIPE_WEBHOOK_SECRET=CHANGE_ME

# --- Provider SDI (se diverso dal mock) ---
SDI_PROVIDER=mock
SDI_API_KEY=CHANGE_ME
SDI_WEBHOOK_SECRET=CHANGE_ME

# --- Voce / LLM di fallback (opzionali) ---
STT_API_KEY=CHANGE_ME
LLM_API_KEY=CHANGE_ME

# --- Litestream: replica DB su bucket S3-compatibile ---
# Esempi di endpoint (sostituisci con i valori del TUO provider):
#   Backblaze B2:  https://s3.<regione>.backblazeb2.com
#   Hetzner:       https://<localita>.your-objectstorage.com
#   Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com  (region: auto)
LITESTREAM_ENDPOINT=https://CHANGE_ME
LITESTREAM_REGION=CHANGE_ME
LITESTREAM_BUCKET=CHANGE_ME
LITESTREAM_PATH=vocepreventivo/prod
LITESTREAM_ACCESS_KEY_ID=CHANGE_ME
LITESTREAM_SECRET_ACCESS_KEY=CHANGE_ME

# --- Backup locali (script backup.sh) ---
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
# Chiave PUBBLICA age (inizia per "age1...") per cifrare gli snapshot; vuoto = non cifra.
# La chiave privata resta fuori dal server (gestore password).
AGE_RECIPIENT=

# --- Aggiunte sicurezza (vedi server/.env.example e docs/SECURITY-REVIEW.md) ---
REQUIRE_TERMS=1
APP_ENCRYPTION_KEY=CHANGE_ME
TERMS_STORE_IP_HASH=0
RATE_LIMIT_STORE=db
TRUST_PROXY=auto
NODE_ENV=production

# --- CORS: origini ammesse a chiamare l'API da altri contesti (separate da virgola, nessuno spazio, MAI "*") ---
# capacitor://localhost = app iOS; https://localhost = app Android; https://[DOMINIO] = la PWA stessa (sostituisci [DOMINIO]).
# La PWA sullo stesso dominio non ne ha bisogno, ma non fa male. L'app nativa richiede anche VITE_API_URL assoluto in fase di build.
CORS_ORIGINS=capacitor://localhost,https://localhost,https://[DOMINIO]

# --- Accesso e audit (vedi server/.env.example) ---
OTP_DIGITS=8
AUDIT_RETENTION_DAYS=365
HEALTH_CACHE_MS=5000
