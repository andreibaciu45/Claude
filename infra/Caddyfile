# Caddy: HTTPS automatico (Let's Encrypt), PWA statica + reverse proxy verso il server.
# DOMAIN e ACME_EMAIL arrivano dalle variabili d'ambiente (file infra/.env).
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		# HSTS: 1 anno + sottodomini. NON aggiungere "preload" finche' tutto il dominio (e i sottodomini) non
		# e' sicuramente servito solo in HTTPS: l'iscrizione alla preload list di Chrome e' di fatto irreversibile.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Solo il microfono (dettatura), e solo per la nostra origine. Tutto il resto disattivato.
		Permissions-Policy "microphone=(self), camera=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), hid=(), midi=(), display-capture=(), accelerometer=(), gyroscope=(), magnetometer=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		X-Permitted-Cross-Domain-Policies "none"
		# CSP SENZA 'unsafe-inline'/'unsafe-eval'. Gli <style> inline (index.html, offline.html, pagine legali, prodotto.html)
		# e l'unico style="" delle guide sono ammessi per HASH: se si modifica uno di quei file, rigenerare gli hash con
		#   node scripts/audit/csp-hashes.cjs dist --print     (e verificare con: node scripts/audit/csp-hashes.cjs dist)
		# connect-src 'self': l'API e' sullo stesso dominio (/v1). Le app native (Capacitor) caricano file locali: NON ricevono
		# questi header; la loro CSP e i loro CORS sono descritti in docs/SECURITY-FRONTEND.md.
		# Se una nuova funzione richiede altre origini (provider esterno) va ampliata QUI in modo esplicito.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'sha256-4MWPxY0bL4Pl5llTmapaNp6of4PXEcseaplxWchvgiw=' 'sha256-anX6GAZGUBvaf1gQokAHoG2DM/hW/TacPbHxnzce1dY=' 'sha256-897EOE4PR6kdWYBuzbGGcNoQsYbOEKQtA2T6V35dzEI=' 'sha256-n0oMAZ1cEmYz43+rX456In++CJBb4k61DnOrFRDjOdE='; style-src-attr 'unsafe-hashes' 'sha256-oJJaKPCjNH03t5E0AX2r5Wz1sontZpvKyfyFqStOGFo='; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-src 'none'; media-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# --- API: tutto cio' che e' /v1/* e /health va al server Node ---
	@api path /v1/* /health
	handle @api {
		header Cache-Control "no-store"
		reverse_proxy server:8787 {
			health_uri /health
			health_interval 15s
		}
	}

	# --- Asset con hash nel nome (Vite): immutabili, cache 1 anno. 404 vero se mancano ---
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# --- Service worker: MAI in cache, cosi' gli aggiornamenti arrivano subito ---
	handle /sw.js {
		root * /srv
		header Cache-Control "no-cache"
		file_server
	}

	# --- Resto della PWA: HashRouter, quindi il fallback e' sempre index.html ---
	handle {
		root * /srv
		@html path / /index.html
		header @html Cache-Control "no-cache"
		@static path /manifest.webmanifest /icon*.png /icon*.svg /apple-touch-icon.png
		header @static Cache-Control "public, max-age=86400"
		try_files {path} {path}/index.html /index.html
		file_server
	}
}
